YOUTUBE_API_KEY=

# Google OAuth (Explore page — his real YouTube subscriptions). Server-only; never NEXT_PUBLIC.
# Create a "Web application" OAuth client in the same Google Cloud project as the Data API key.
# Authorized redirect URIs: http://localhost:3000/api/auth/youtube/callback  and the prod equivalent.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Random 32+ char string used to encrypt the refresh-token cookie (e.g. `openssl rand -base64 32`).
OAUTH_TOKEN_SECRET=
